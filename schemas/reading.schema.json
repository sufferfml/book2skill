{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reading",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "minItems": 1
    },
    "disposition": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "read",
        "excluded"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "segment_ids",
    "disposition",
    "reason",
    "discoveries",
    "conditions",
    "counterexamples",
    "connections",
    "questions"
  ],
  "additionalProperties": false
}
