{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "source_manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "builder_context": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "core": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "minItems": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "minItems": 0
          },
          "conditional": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "module_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "module_id",
                "condition"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "when",
          "text",
          "source_ids",
          "requires",
          "conditional"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "archive_only": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "passage_id",
          "source_sha256",
          "start",
          "end",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "source_manifest_hash",
    "builder_context",
    "description",
    "core",
    "modules",
    "archive_only",
    "spans"
  ],
  "additionalProperties": false
}
