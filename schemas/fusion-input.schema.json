{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fusion-input",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "run_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "run_path"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    }
  },
  "required": [
    "schema_version",
    "books"
  ],
  "additionalProperties": false
}
