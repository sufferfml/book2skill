{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime-review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "source_manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "fresh_context": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "preserved",
              "revise"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "verdict",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "source_manifest_hash",
    "plan_hash",
    "reviewer",
    "context_id",
    "fresh_context",
    "items",
    "unresolved"
  ],
  "additionalProperties": false
}
