{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "usage",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "input_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "uncertain": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "task",
    "status",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "duration_seconds",
    "uncertain"
  ],
  "additionalProperties": false
}
