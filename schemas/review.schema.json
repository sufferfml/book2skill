{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "model_hash": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "verdict": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "supported",
              "unsupported",
              "uncertain",
              "hypothesis"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "minItems": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "verdict",
          "evidence_refs",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "model_hash",
    "reviewer",
    "items",
    "unresolved"
  ],
  "additionalProperties": false
}
