{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "answer",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 0
    },
    "error": {
      "type": "string",
      "minLength": 0
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "fresh_context": {
      "type": "boolean"
    },
    "actual_material_chars": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "uncertain": {
      "type": "boolean"
    },
    "access_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "returned_chars": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "returned_chars",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "status",
    "answer",
    "error",
    "model",
    "host",
    "context_id",
    "fresh_context",
    "actual_material_chars",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "duration_seconds",
    "uncertain"
  ],
  "additionalProperties": false
}
