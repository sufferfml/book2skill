{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fusion-model",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.0.1"
    },
    "builder_context": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.0.1"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "epistemic_origin": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "author_explicit",
                  "author_reconstructed",
                  "model_extension",
                  "cross_book_synthesis",
                  "cross_book_synthesis"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "minItems": 0
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "statement",
              "epistemic_origin",
              "evidence_refs",
              "conditions",
              "unknowns"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "from_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "to_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "supports",
                  "depends_on",
                  "limits",
                  "contradicts",
                  "illustrates"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "epistemic_origin": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "author_explicit",
                  "author_reconstructed",
                  "model_extension",
                  "cross_book_synthesis",
                  "cross_book_synthesis"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "from_id",
              "to_id",
              "kind",
              "explanation",
              "epistemic_origin",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "procedure",
                  "causal",
                  "argument",
                  "diagnostic",
                  "normative",
                  "mixed"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "minItems": 1
              },
              "relation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "minItems": 1
              },
              "dependency_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "minItems": 0
              },
              "applicability": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "mapping": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "revision": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "question",
              "mechanism",
              "claim_ids",
              "relation_ids",
              "dependency_ids",
              "applicability",
              "boundaries",
              "observations",
              "mapping",
              "alternatives",
              "checks",
              "revision",
              "unknowns"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "schema_version",
        "claims",
        "relations",
        "frameworks"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "minItems": 1
          },
          "bridge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "minItems": 0
          }
        },
        "required": [
          "target_id",
          "input_ids",
          "bridge_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "builder_context",
    "model",
    "lineage"
  ],
  "additionalProperties": false
}
